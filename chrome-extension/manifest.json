{
    "manifest_version": 3,
    "name": "Redis Agent Memory Inspector",
    "description": "Inspect working memory and long-term memory of any app that uses Redis Agent Memory Server",
    "version": "0.1.0",
    "action": {
        "default_title": "Redis Agent Memory Inspector",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.redis.io/*",
        "https://redis-agent-memory-inspector.vercel.app/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ]
}
